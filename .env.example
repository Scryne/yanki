# Kopyala: .env (gitignore'da, depoya girmez).
# Keşif ve takip: developer.spotify.com/dashboard → Create app (sahibin Premium'u şart, Şubat 2026)
#   Redirect URI: http://127.0.0.1:8766/callback   (localhost kabul edilmiyor)
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Keşifte özgünlük kararı (yanki/yargi.py, TypeSafe Jev). Yoksa regex yedeği; kullanıcı ortam değişkeni de olur.
TYPESAFE_API_KEY=
# Kiralık GPU (yanki/runpod.py): üretim ve eğitim. İkinci hesap isteğe bağlı; ilkinin bakiyesi bitince ona geçilir.
RUNPOD_API_KEY=
RUNPOD_API_KEY_2=
# RouteNote onay/düzeltme/red e-postaları (yanki/eposta.py, salt okunur IMAP): RouteNote hesabının Gmail adresi ve
#   uygulama şifresi (Google hesabı → Güvenlik → 2 adımlı doğrulama → Uygulama şifreleri). Gmail dışı: EPOSTA_SUNUCU.
EPOSTA_KULLANICI=
EPOSTA_SIFRE=
# RouteNote'un anahtarı yok: oturum tarayıcı profilinde (yanki routenote giris), şifre hiçbir yerde tutulmaz.
# Tunearo API'si 2026-10-12'de kapandı; anahtar yalnız config/yayin.toml → dagitimci = "tunearo" seçilirse okunur.
TUNEARO_API_KEY=
