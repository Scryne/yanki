# Kopyala: .env (gitignore'da, depoya girmez). `yanki kesif` ve `yanki takip` için.
# developer.spotify.com/dashboard → Create app (sahibin Premium'u şart, Şubat 2026)
#   Redirect URI: http://127.0.0.1:8766/callback   (localhost kabul edilmiyor)
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Keşifte özgünlük kararı (yanki/yargi.py, TypeSafe Jev). Yoksa regex yedeği; kullanıcı ortam değişkeni de olur.
TYPESAFE_API_KEY=
# Stok kapak (config/yayin.toml → [kapak] kaynak = "stok"): biri yeter, ikisi de varsa önce Unsplash.
#   unsplash.com/oauth/applications/new → Access Key (saatte 50 istek)
#   pexels.com/api/new → API Key (saatte 200 istek)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Tunearo dağıtım API'si (config/yayin.toml → dagitimci = "tunearo"): hat paketi kendisi yükler ve durumunu yoklar.
TUNEARO_API_BASE_URL=https://dashboard.tunearo.com/api/public/v1
TUNEARO_API_KEY=
TUNEARO_WEBHOOK_SECRET=
DISTRIBUTION_PROVIDER=tunearo
